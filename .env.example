# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Booking page (/book): open times are your weekly intro-call hours minus Google Calendar busy times. Confirm
# books the call on Google Calendar and emails the client and you from Gmail. All of this is server-side only.
# Google, with no key: on Vercel the function's OIDC token is exchanged through Workload Identity Federation for a
# short-lived token that impersonates the service account. See "Booking page setup" in README.md.
GCP_PROJECT_NUMBER=""
GCP_WORKLOAD_IDENTITY_POOL_ID=""
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=""
# The service account. The booking calendar is shared with it as "Make changes to events"; any other calendar
# that should block times can be shared as "See only free/busy (hide details)".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Calendars whose busy times block bookings, comma separated. The first one gets the intro-call events.
GOOGLE_CALENDAR_IDS=""
# Gmail that sends the emails, and an app password for it (Google Account > Security > App passwords). Secret.
SMTP_USER=""
SMTP_PASS=""
# Optional. Weekly intro-call hours, Los Angeles time (default "mon-fri 10:00-18:00").
# Examples: "mon-fri 10:00-18:00; sat 10:00-14:00" or "tue,thu 09:30-12:00,13:00-17:00".
BOOKING_HOURS=""
# Optional. Length of an intro call in minutes (default 15).
BOOKING_SLOT_MINUTES=""
# Optional. Minimum notice in hours (default 4) and how many days ahead people can book (default 60).
BOOKING_MIN_NOTICE_HOURS=""
BOOKING_MAX_DAYS_AHEAD=""
# Optional. Calendar to write intro calls to (default: the first of GOOGLE_CALENDAR_IDS).
BOOKING_CALENDAR_ID=""
# Optional. Who gets the "new intro call" email (default: SMTP_USER).
BOOKING_NOTIFY_EMAIL=""
# Optional. How the call happens, shown in the client's confirmation and invite.
BOOKING_MEETING_DETAILS=""
# Optional. Sender name on the emails (default "Zane Luper").
SMTP_FROM_NAME=""
# Preview only: client emails go only to these addresses (default luperdev@gmail.com). Production emails anyone.
BOOKING_TEST_EMAIL_ALLOWLIST=""

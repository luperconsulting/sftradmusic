# SF Trad Music: copy to .env.local for local work, and set the same names in Vercel for deployed environments.
# Placeholders only. Never commit real values.

# --- App ---
APP_URL="https://www.sftradmusic.com"

# --- Supabase (browser-safe: VITE_ values ship in the frontend bundle, and are read at BUILD time,
#     so redeploy after changing them). Use the publishable key (sb_publishable_...) or the legacy anon key. ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Supabase (server only). SUPABASE_SERVICE_ROLE_KEY takes the secret key (sb_secret_...) or the legacy
#     service_role key. SUPABASE_ANON_KEY isn't read by the server today and is optional. ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_VIDEO_BUCKET="lesson-videos"

# --- Preview safe mode (server only) ---
# Leave unset to turn it on everywhere except a production deployment (Vercel Preview included).
# On: portal email (invoices, payments, lesson bookings) goes only to SAFE_MODE_EMAIL_ALLOWLIST.
# Safe mode does not block Supabase portal-invitation or password-reset email.
# SAFE_MODE="true"

# --- GoHighLevel (LEGACY, migration scripts only) ---
# The portal no longer reads any GHL_* variable. Students, lessons, invoices and payments live in Supabase.
# Only scripts that migrate old GoHighLevel records use these. Leave them out of every portal environment.
# GHL_PRIVATE_INTEGRATION_TOKEN=""
# GHL_LOCATION_ID=""
# GHL_LESSON_CALENDAR_ID=""

# Who may be emailed a portal invitation while safe mode is on. Unset means luperdev@gmail.com only.
# A non-empty value replaces that default. Add the Preview origin's /invite path to the Supabase redirect allow list.
# SAFE_MODE_EMAIL_ALLOWLIST="luperdev@gmail.com"

# --- Portal email (server only): Gmail SMTP as zane@sftradmusic.com, smtp.gmail.com port 587. ---
# Never commit the app password. If either value is missing, email is logged instead of sent.
SMTP_USER="zane@sftradmusic.com"
SMTP_PASS="your-gmail-app-password"

# --- Card payments: Stripe Checkout in TEST MODE only. Off unless CARD_PAYMENTS_ENABLED=true. ---
# Both keys must be test keys (sk_test_ and pk_test_); live keys are ignored. No autopay.
# The webhook endpoint is /api/webhooks/stripe (event: checkout.session.completed).
CARD_PAYMENTS_ENABLED="false"
STRIPE_SECRET_KEY="sk_test_your-key"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your-key"
STRIPE_WEBHOOK_SECRET="whsec_your-test-webhook-secret"

# --- Ops summary for the Grok bot: GET /api/ops/summary with "Authorization: Bearer <token>". ---
# At least 24 characters. Unset turns the endpoint off.
OPS_API_TOKEN=""

# --- Booking page widget: intro-call slot length in minutes (default 15). Open times come from the
#     teacher's weekly lesson hours in the portal, minus Google Calendar busy times. ---
BOOKING_SLOT_MINUTES=""

# --- Local development only: fills the portal with labeled sample data. Ignored by production builds. ---
VITE_PORTAL_DEMO="false"

# --- Google Calendar free/busy (server only, read-only, no key) ---
# On Vercel the function's OIDC token is exchanged through Workload Identity Federation for a short-lived token that
# impersonates the service account. See "Google Calendar setup" in README.md. Busy times block lesson and intro slots.
GCP_PROJECT_NUMBER=""
GCP_WORKLOAD_IDENTITY_POOL_ID=""
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=""
# The service account each calendar is shared with as "See only free/busy (hide details)".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Calendars whose busy times block bookings, comma separated.
GOOGLE_CALENDAR_IDS=""

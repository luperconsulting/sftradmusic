# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Booking page (/book): open times are GoHighLevel's calendar rules minus Google Calendar busy times, read server-side only.
# GoHighLevel, read-only (calendars.readonly is enough): the token and the location it belongs to.
GHL_PRIVATE_INTEGRATION_TOKEN=""
GHL_LOCATION_ID=""
# Google Calendar free/busy with no key: on Vercel the function's OIDC token is exchanged through Workload Identity
# Federation for a short-lived token that impersonates the service account. See "Google Calendar setup" in README.md.
GCP_PROJECT_NUMBER=""
GCP_WORKLOAD_IDENTITY_POOL_ID=""
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=""
# The service account each calendar is shared with as "See only free/busy (hide details)".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Calendars whose busy times block bookings, comma separated (usually your Gmail address for the primary calendar).
GOOGLE_CALENDAR_IDS=""
# Optional. The GoHighLevel calendar whose open hours and rules are the base availability (default: the intro-call calendar).
BOOKING_GHL_CALENDAR_ID=""
# Optional. Length of an intro call in minutes, used for overlap checks (default 15).
BOOKING_SLOT_MINUTES=""

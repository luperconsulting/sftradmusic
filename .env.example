# SF Trad Music: copy to .env.local for local work, and set the same names in Vercel for deployed environments.
# Placeholders only. Never commit real values.

# --- App ---
APP_URL="https://www.sftradmusic.com"

# --- Supabase (browser-safe: VITE_ values ship in the frontend bundle, and are read at BUILD time,
#     so redeploy after changing them). Use the publishable key (sb_publishable_...) or the legacy anon key. ---
VITE_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
VITE_SUPABASE_ANON_KEY="your-supabase-anon-key"

# --- Supabase (server only). SUPABASE_SERVICE_ROLE_KEY takes the secret key (sb_secret_...) or the legacy
#     service_role key. SUPABASE_ANON_KEY isn't read by the server today and is optional. ---
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
SUPABASE_VIDEO_BUCKET="lesson-videos"

# --- GoHighLevel (server only) ---
GHL_PRIVATE_INTEGRATION_TOKEN="your-ghl-private-integration-token"
GHL_LOCATION_ID="your-ghl-location-id"
GHL_LESSON_CALENDAR_ID="your-ghl-lesson-calendar-id"
GHL_TIMEZONE="America/Los_Angeles"
# The GHL user invoices are sent as. Leave empty and Pay Now tells customers to use their existing invoice link.
# Setting this lets Pay Now send real messages, and the token also needs the invoices.write scope.
GHL_INVOICE_SENDER_USER_ID=""
GHL_WEBHOOK_PUBLIC_KEY=""
# Safe mode. Leave unset to turn it on everywhere except a production deployment (Vercel Preview included).
# On: new contacts are do-not-disturb and tagged portal-test, bookings do not notify, and Pay Now only logs.
# Set to false only when that environment should send real GoHighLevel email. SMS is never sent.
# Safe mode does not block Supabase portal-invitation or password-reset email.
# GHL_SAFE_MODE="true"
# Who may be emailed a portal invitation while safe mode is on. Unset means luperdev@gmail.com only.
# A non-empty value replaces that default. Add the Preview origin's /invite path to the Supabase redirect allow list.
# SAFE_MODE_EMAIL_ALLOWLIST="luperdev@gmail.com"

# --- Referral email (server only). smtp.gmail.com port 587. Never commit the app password. ---
# If either value is missing, referral email is logged and the request still succeeds.
SMTP_USER="zane@sftradmusic.com"
SMTP_PASS="your-gmail-app-password"

# --- Stripe test mode (preview). The secret stays on the server. The publishable key is inlined at build time. ---
# Both must be test keys (sk_test_ and pk_test_). Live keys are ignored. Safe mode never charges.
STRIPE_SECRET_KEY="sk_test_your-key"
VITE_STRIPE_PUBLISHABLE_KEY="pk_test_your-key"

# --- Local development only: fills the portal with labeled sample data. Ignored by production builds. ---
VITE_PORTAL_DEMO="false"

# Public booking widget (/book): Google Calendar free/busy, read server-side only and with no key.
# On Vercel the function's OIDC token is exchanged through Workload Identity Federation for a short-lived
# token that impersonates the service account. See "Google Calendar setup" in README.md.
GCP_PROJECT_NUMBER=""
GCP_WORKLOAD_IDENTITY_POOL_ID=""
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=""
# The service account each calendar is shared with as "See only free/busy (hide details)".
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Calendars whose busy times block bookings, comma separated (usually your Gmail address for the primary calendar).
GOOGLE_CALENDAR_IDS=""
# Optional. The GoHighLevel calendar whose open hours and rules are the base availability (default: the intro-call calendar).
BOOKING_GHL_CALENDAR_ID=""
# Optional. Length of an intro call in minutes, used for overlap checks (default 15).
BOOKING_SLOT_MINUTES=""

{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=build/server.cjs",
    "start": "node build/server.cjs",
    "clean": "rm -rf dist build",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "seed:arzo": "tsx scripts/seed-arzo.ts",
    "seed:arzo:videos": "tsx scripts/seed-arzo-videos.ts",
    "seed:arzo:cleanup": "tsx scripts/cleanup-arzo.ts"
  },
  "dependencies": {
    "@phosphor-icons/web": "^2.1.2",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/oidc": "^4.0.8",
    "@vitejs/plugin-react": "^5.0.4",
    "express": "^4.21.2",
    "google-auth-library": "^11.3.4",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "nodemailer": "^10.3.1",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.5",
    "stripe": "^23.1.0",
    "vite": "^6.2.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^6.0.3",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^3.2.7"
  }
}
